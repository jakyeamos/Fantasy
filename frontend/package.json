{
  "name": "fantasy-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format": "prettier --check . --ignore-unknown",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "audit:dead-code": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "browser:install": "playwright install chromium",
    "browser:smoke": "node scripts/browserSmoke.mjs",
    "routes:smoke": "node scripts/browserSmoke.mjs",
    "smoke": "pnpm browser:smoke",
    "pre-pr": "pnpm typecheck && pnpm test:render",
    "test:render": "node tests/marketGapRender.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.91.3",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-router": "^1.168.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/router-plugin": "^1.167.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint-plugin-anti-slop": "file:../../eslint-plugin-anti-slop",
    "playwright": "^1.61.1",
    "prettier": "3.6.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.1"
  }
}

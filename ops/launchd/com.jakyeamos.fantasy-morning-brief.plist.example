<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jakyeamos.fantasy-morning-brief</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>python</string>
    <string>-m</string>
    <string>fantasy.intelligence</string>
    <string>run</string>
    <string>--scheduled</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__FANTASY_REPO__/backend</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>FANTASY_DB_PATH</key>
    <string>__FANTASY_REPO__/data/fantasy.duckdb</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/tmp/fantasy-morning-brief.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/fantasy-morning-brief.error.log</string>
</dict>
</plist>
